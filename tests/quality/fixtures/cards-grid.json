{
  "innerHTML": "\n\n        <!-- ══════════════════════════════════════════════════════════════════════\n             КАРТОЧКИ\n             ─────────────────────────────────────────────────────────────────────\n             Как заменить плейсхолдер на реальное превью:\n\n             1. Положи JPG/WEBP в ./assets/img/work/ с именем как в src= ниже.\n                Рекомендуемый размер: 800×600 (4:3), ≤200 KB.\n             2. Готово. Если файл существует — он покажется. Если нет —\n                градиент + лейбл остаются как плейсхолдер (делегированный\n                error-handler в main.js удаляет <img>, см. v0.8.8a).\n\n             Рекомендуемые форматы:\n             - .webp (лучшее сжатие)  → orbital-mk-ii.webp\n             - .jpg  (fallback)        → orbital-mk-ii.jpg\n\n             Рекомендация по именованию: kebab-case, латиница, без пробелов.\n             См. ./assets/img/work/README.md\n        ══════════════════════════════════════════════════════════════════════ -->\n\n        <!-- 4 -->\n        <a class=\"work-card work-card--active\" data-id=\"corten-series\" data-category=\"product\" href=\"#corten-series\" aria-current=\"page\">\n          <div class=\"work-card__thumb\" data-label=\"Corten Series\">\n            <img src=\"./assets/cards/corten-series.svg\" data-i18n-attr=\"alt:card.corten-series.alt\" alt=\"Corten Series — industrial furniture product viz\" loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"600\">\n          </div>\n          <div class=\"work-card__info\">\n            <div class=\"work-card__meta\"><span class=\"work-card__cat\">Product</span><span class=\"work-card__meta-tail\"><span class=\"work-card__year\">2025</span><span class=\"work-card__hint\" aria-hidden=\"true\">↗</span></span></div>\n            <h2 class=\"work-card__title\" data-i18n=\"card.corten-series.title\">Corten Series</h2>\n            <p class=\"work-card__desc\" data-i18n=\"card.corten-series.desc\">Product viz for an industrial furniture brand. Launch-ready renders.</p>\n          </div>\n        </a>\n\n        <!-- 5 -->\n        <a class=\"work-card\" data-id=\"lumen-one\" data-category=\"product\" href=\"#lumen-one\">\n          <div class=\"work-card__thumb\" data-label=\"Lumen One\">\n            <img src=\"./assets/cards/lumen-one.svg\" data-i18n-attr=\"alt:card.lumen-one.alt\" alt=\"Lumen One — architectural lighting unit\" loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"600\">\n          </div>\n          <div class=\"work-card__info\">\n            <div class=\"work-card__meta\"><span class=\"work-card__cat\">Product</span><span class=\"work-card__meta-tail\"><span class=\"work-card__year\">2024</span><span class=\"work-card__hint\" aria-hidden=\"true\">↗</span></span></div>\n            <h2 class=\"work-card__title\" data-i18n=\"card.lumen-one.title\">Lumen One</h2>\n            <p class=\"work-card__desc\" data-i18n=\"card.lumen-one.desc\">Architectural lighting unit. Photorealistic turntable for pitch deck.</p>\n          </div>\n        </a>\n\n        <!-- 6 -->\n        <a class=\"work-card\" data-id=\"flux-capsule\" data-category=\"product\" href=\"#flux-capsule\">\n          <div class=\"work-card__thumb\" data-label=\"Flux Capsule\">\n            <img src=\"./assets/cards/flux-capsule.svg\" data-i18n-attr=\"alt:card.flux-capsule.alt\" alt=\"Flux Capsule — consumer tech device\" loading=\"lazy\" decoding=\"async\" width=\"800\" height=\"600\">\n          </div>\n          <div class=\"work-card__info\">\n            <div class=\"work-card__meta\"><span class=\"work-card__cat\">Product</span><span class=\"work-card__meta-tail\"><span class=\"work-card__year\">2024</span><span class=\"work-card__hint\" aria-hidden=\"true\">↗</span></span></div>\n            <h2 class=\"work-card__title\" data-i18n=\"card.flux-capsule.title\">Flux Capsule</h2>\n            <p class=\"work-card__desc\" data-i18n=\"card.flux-capsule.desc\">Consumer tech device. E-commerce shot set, studio lighting rig.</p>\n          </div>\n        </a>\n\n        <!-- A1-20 — empty-state for a filter combination with zero matches. Hidden\n             by default; shown via body.filter-empty (set in applyFilters). The zero\n             state is announced to assistive tech by the #cards-count aria-live region\n             (\"0 projects\"); this <p> is the visible explanation for sighted users and\n             carries NO role=status — toggling display on a static-text live region is\n             not reliably announced (NVDA/JAWS/VoiceOver). data-i18n keeps it bilingual.\n             Lives outside the GEN region so content:generate never rewrites it. -->\n        <p class=\"cards-empty\" data-i18n=\"empty.projects\">No projects match these filters yet.</p>\n\n      "
}
